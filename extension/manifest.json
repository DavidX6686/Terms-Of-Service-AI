{
  "manifest_version": 3,
  "name": "ClauseGuard — ToS Scanner",
  "version": "0.1.0",
  "description": "Detects Terms of Service pages, links, and agreement checkboxes, then pops up so you can scan and track them.",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClauseGuard",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
